# Auth0 (Phase 1 — POC-only password grant, never use in production)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=your-api-identifier
AUTH0_CLIENT_ID=...
AUTH0_CLIENT_SECRET=...
AUTH0_TEST_USERNAME=testuser@example.com
AUTH0_TEST_PASSWORD=...

# GCP
GCP_PROJECT_ID=...
GCP_LOCATION=us-central1
REASONING_ENGINE_ID=...      # filled in after agent/deploy.py runs
FRONTDOOR_URL=...            # filled in after Cloud Run deploy

# AWS AgentCore Gateway
GATEWAY_AUDIENCE=...         # matches allowedAudiences in create_gateway.sh
GATEWAY_MCP_URL=...          # filled in after create_gateway.sh runs

# AWS (used by aws/gateway/create_gateway.sh)
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=poc-hello-world
LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/poc-lambda-execution-role
GATEWAY_NAME=poc-gateway
GATEWAY_SERVICE_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/poc-agentcore-gateway-role
