VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://gemini-agent-poc/api
VITE_FRONTDOOR_URL=http://localhost:8080
# Lets the app run end-to-end with a locally-entered display name before a
# real Auth0 tenant is wired up. Set to false (or remove) once VITE_AUTH0_DOMAIN
# points at a real tenant.
VITE_ALLOW_MOCK_AUTH=true
VITE_PORT=5173
