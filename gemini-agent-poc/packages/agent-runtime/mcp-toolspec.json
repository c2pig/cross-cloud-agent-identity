{
  "tools": [
    {
      "name": "search_property",
      "title": "Search Property",
      "description": "Search mock property listings by city, max price, minimum bedrooms, and property type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "maxPrice": {
            "type": "number"
          },
          "minBedrooms": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "condo",
              "house",
              "townhouse"
            ]
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_preference",
      "title": "Get Preference",
      "description": "Read the calling user's saved search preference.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "userId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "update_preference",
      "title": "Update Preference",
      "description": "Update the calling user's saved search preference. Requires a valid on-behalf-of (OBO) delegation token minted only after the user approved this exact change -- this is a write, never call it without one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "patch": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "maxPrice": {
                "type": "number"
              },
              "minBedrooms": {
                "type": "number"
              },
              "type": {
                "type": "string",
                "enum": [
                  "condo",
                  "house",
                  "townhouse"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "userId",
          "patch"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}