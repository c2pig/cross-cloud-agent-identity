# Shared config for the three backend services (frontdoor, agent-service,
# mcp-server). Copy to .env at this same path -- each service's src/index.js
# loads this file directly so the shared secrets below stay in sync across
# processes during local dev.
#
# The frontend has its own env file: packages/frontend/.env.example
# (Vite only loads .env files from the package it runs in).

# --- Auth0 (source of trust for user identity) ---
# Leave AUTH0_DOMAIN as the placeholder below to run in mock-auth mode with
# zero Auth0 setup (see ALLOW_MOCK_AUTH). Point it at a real tenant to use
# real Auth0 Universal Login end to end.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://gemini-agent-poc/api
ALLOW_MOCK_AUTH=true

# --- frontdoor ---
FRONTDOOR_PORT=8080
AGENT_SERVICE_URL=http://localhost:8081
# Stands in for a real trust-broker signing key (see docs/gcp-mapping.md).
# Any long random string works for local dev; Terraform generates one for
# the deployed environment.
OBO_SIGNING_SECRET=dev-only-change-me-obo-secret
# Shared secret simulating "Agent Gateway ingress allow-lists only the front
# door's identity as a caller" -- must match agent-service's copy below.
FRONTDOOR_TO_AGENT_KEY=dev-only-change-me-frontdoor-key

# --- agent-service ---
AGENT_SERVICE_PORT=8081
MCP_SERVER_URL=http://localhost:8082
AGENT_IDENTITY_ID=agents/real-estate-agent-v1
# Stands in for the ID token Vertex AI Agent Engine automatically attaches
# to its principal identity (see docs/gcp-mapping.md). Must match
# mcp-server's copy below.
AGENT_IDENTITY_SIGNING_SECRET=dev-only-change-me-agent-identity-secret
# Must match frontdoor's copy above.
# FRONTDOOR_TO_AGENT_KEY is read from the shared value set above.
# Optional: set to use real Gemini function-calling instead of the mock planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- mcp-server ---
MCP_SERVER_PORT=8082
# AGENT_IDENTITY_SIGNING_SECRET and OBO_SIGNING_SECRET are read from the
# shared values set above -- mcp-server verifies both.

# --- deploy.sh / infra ---
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
IMAGE_TAG=latest
AUTH0_CLIENT_ID=
